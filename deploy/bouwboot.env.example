# Wachtwoord voor het hele huis
APP_PASSWORD=

# Zelfde Gemini-sleutel als in GitHub
GEMINI_API_KEY=
# Optioneel: ander Gemini-model (standaard gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Modal: het token-geheim (as-...). Hieruit wordt de sleutel voor de GPU-dienst afgeleid.
MODAL_TOKEN_SECRET=
GPU_URL=https://jdatje--bouwboot-gpu-designer-web.us-east.modal.run

REBRICKABLE_API_KEY=

# Server
PORT=3000
DATA_DIR=/var/lib/bouwboot
# Het adres waarop je de site opent (nodig voor uploads), bijv. https://bouwboot.taila44a3a.ts.net
ORIGIN=
BODY_SIZE_LIMIT=30M
